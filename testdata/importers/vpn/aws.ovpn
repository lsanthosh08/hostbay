# Shaped like the file the AWS Client VPN console downloads.
client
dev tun
proto udp
remote cvpn-endpoint-0123456789abcdef0.prod.clientvpn.ap-southeast-1.amazonaws.com 443
remote-random-hostname
resolv-retry infinite
nobind
remote-cert-tls server
cipher AES-256-GCM
verb 3
<ca>
-----BEGIN CERTIFICATE-----
FakeAwsCAEMzwLWsGpClYksBLfgW1WcKT1WPeIBZEXniIi58ljKPm8a5mUny82+
-----END CERTIFICATE-----
</ca>
auth-user-pass
auth-federate
auth-retry interact
auth-nocache
reneg-sec 0
