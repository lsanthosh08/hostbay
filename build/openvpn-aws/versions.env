# Pinned sources for openvpn-aws. build.sh and build.ps1 read this file.
# Every tarball is checked against its SHA-256 here before it is unpacked,
# and a mismatch stops the build. Each hash matches the one its upstream
# publishes (GitHub release digest or .sha256 file), or, where upstream
# publishes none, the one Debian (LZO) or Fedora (libcap-ng) ships.
#
# Plain KEY=value lines only: build.ps1 parses this file without a shell.

OPENVPN_VERSION=2.7.9
OPENVPN_URL=https://swupdate.openvpn.org/community/releases/openvpn-2.7.9.tar.gz
OPENVPN_SHA256=c42a6ed892ddfe2d6e3317a5040f19bec5827564affb2fe3f2b3904a94daacb1

# The 3.5 long-term-support branch.
OPENSSL_VERSION=3.5.9
OPENSSL_URL=https://github.com/openssl/openssl/releases/download/openssl-3.5.9/openssl-3.5.9.tar.gz
OPENSSL_SHA256=603f5602e2eef00d77fbd429d34dcd5822bb301757a1bc9cdb24c670f1eb859a

LZO_VERSION=2.10
LZO_URL=https://www.oberhumer.com/opensource/lzo/download/lzo-2.10.tar.gz
LZO_SHA256=c0f892943208266f9b6543b3ae308fab6284c5c90e627931446fb49b4221a072

LZ4_VERSION=1.11.1
LZ4_URL=https://github.com/lz4/lz4/releases/download/v1.11.1/lz4-1.11.1.tar.gz
LZ4_SHA256=683fed08a844ad012196381e40badf80c0bbe4962959761416d41c9e67d77ec7

# Linux only. 0.8.5 is the newest release upstream publishes as a tarball
# with a generated configure; 0.9.x exists only as git tags, which would
# need autoconf, automake and libtool (and llvm-strip) to build.
LIBCAPNG_VERSION=0.8.5
LIBCAPNG_URL=https://people.redhat.com/sgrubb/libcap-ng/libcap-ng-0.8.5.tar.gz
LIBCAPNG_SHA256=3ba5294d1cbdfa98afaacfbc00b6af9ed2b83e8a21817185dfd844cc8c7ac6ff

# Windows only: the vcpkg commit (release 2026.10.16) whose ports supply
# OpenSSL, LZO, LZ4 and the TAP-Windows headers there. Its versions are
# vcpkg's (OpenSSL 3.6.5, LZ4 1.10.0, LZO 2.10), not the pins above, since
# vcpkg's version database has no OpenSSL 3.5.9 or LZ4 1.11.1.
VCPKG_COMMIT=9eec002df1cd109f8f104cd966a763daf9751489
