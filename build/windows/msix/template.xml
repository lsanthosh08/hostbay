<?xml version="1.0" encoding="utf-8"?>
<MsixPackagingToolTemplate
    xmlns="http://schemas.microsoft.com/msix/packaging/msixpackagingtool/template/2022">
    <Settings
        AllowTelemetry="false"
        ApplyACLsToPackageFiles="true"
        GenerateCommandLineFile="true"
        AllowPromptForPassword="false">
    </Settings>
    <Installer
        Path="hostbay"
        Arguments=""
        InstallLocation="C:\Program Files\Hostbay\Hostbay">
    </Installer>
    <PackageInformation
        PackageName="Hostbay"
        PackageDisplayName="Hostbay"
        PublisherName="CN=Hostbay"
        PublisherDisplayName="Hostbay"
        Version="0.1.0.0"
        PackageDescription="SSH, RDP and server manager">
        <Capabilities>
            <Capability Name="runFullTrust" />
            
        </Capabilities>
        <Applications>
            <Application
                Id="dev.hostbay.app"
                Description="SSH, RDP and server manager"
                DisplayName="Hostbay"
                ExecutableName="hostbay"
                EntryPoint="Windows.FullTrustApplication">
                
            </Application>
        </Applications>
        <Resources>
            <Resource Language="en-us" />
        </Resources>
        <Dependencies>
            <TargetDeviceFamily Name="Windows.Desktop" MinVersion="10.0.17763.0" MaxVersionTested="10.0.19041.0" />
        </Dependencies>
        <Properties>
            <Framework>false</Framework>
            <DisplayName>Hostbay</DisplayName>
            <PublisherDisplayName>Hostbay</PublisherDisplayName>
            <Description>SSH, RDP and server manager</Description>
            <Logo>Assets\AppIcon.png</Logo>
        </Properties>
    </PackageInformation>
    <SaveLocation PackagePath="hostbay.msix" />
    <PackageIntegrity>
        <CertificatePath></CertificatePath>
    </PackageIntegrity>
</MsixPackagingToolTemplate>
